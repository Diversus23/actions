#Использовать logos

// Лог модуля
Перем Лог;

#Область ПрограммныйИнтерфейс

// Структура для преобразования произвольного файла Markdown
//
// Возвращаемое значение:
//	Структура - конвертация
Функция КонструкторКонвертирования() Экспорт

	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("ИсходныйФайл", "");
	ПараметрыКоманды.Вставить("ФайлРезультат", "");
	ПараметрыКоманды.Вставить("Шаблон", "Softonit.html");
	ПараметрыКоманды.Вставить("Заголовок", "");
	ПараметрыКоманды.Вставить("ИмяПродукта", "");
	ПараметрыКоманды.Вставить("МинимизироватьHTML", Ложь);
	ПараметрыКоманды.Вставить("МаксимальнаяШиринаИзображения", 0);
	ПараметрыКоманды.Вставить("ИспользоватьЛенивуюЗагрузку", Ложь);
	Возврат ПараметрыКоманды;

КонецФункции

// Список доступных шаблонов оформления
//
// Возвращаемое значение:
//	Массив Из Строк - список доступных шаблонов
//
Функция МассивШаблонов() Экспорт

	Результат = Новый Массив();
	Для Каждого Шаблон Из РаботаСChangeLog.МассивШаблонов() Цикл
		Если СтрЗаканчиваетсяНа(НРег(Шаблон), ".html") Тогда
			Результат.Добавить(Шаблон);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Конвертирует произвольный файл Markdown в HTML по шаблону оформления
//
// В отличие от РаботаСChangeLog.Конвертировать файл не разбирается на версии: документ целиком
// подставляется в шаблон оформления, шаблон элемента версии (Item) не используется. Это позволяет
// оформлять по тем же шаблонам любой Markdown, например README.md с инструкцией по установке.
//
// Параметры:
//  Параметры    - Структура     - структура конвертации, см. КонструкторКонвертирования
//
Процедура Конвертировать(Знач Параметры) Экспорт

	Лог.Информация("Начало конвертации файла Markdown");

	ФайлОсновной = Параметры.ИсходныйФайл;
	Если НЕ ФайловыеОперации.ФайлСуществует(ФайлОсновной) Тогда
		ТекстОшибки = "Опция ""--in"" - содержит полный путь к не существующему файлу Markdown";
		ОбщегоНазначения.ЗавершениеРаботыОшибка(ТекстОшибки);
	КонецЕсли;

	Если НЕ СтрЗаканчиваетсяНа(НРег(Параметры.Шаблон), ".html") Тогда
		ТекстОшибки = "Опция ""--template"" - поддерживаются только HTML-шаблоны, передан ""%1""";
		ОбщегоНазначения.ЗавершениеРаботыОшибка(ТекстОшибки, Параметры.Шаблон);
	КонецЕсли;

	Лог.Информация("Шаблон: ""%1""", Параметры.Шаблон);

	ТекстMD = ФайловыеОперации.ПрочитатьТекстФайла(ФайлОсновной);
	Если ПустаяСтрока(ТекстMD) Тогда
		Лог.Предупреждение("Файл %1 пустой, результат будет содержать только оформление шаблона", ФайлОсновной);
	КонецЕсли;

	ТекстHTML = РаботаСChangeLog.КонвертироватьВHTML(ТекстMD);
	ТекстHTML = РаботаСChangeLog.ОбработатьИзображенияHTML(ТекстHTML,
		Параметры.МаксимальнаяШиринаИзображения, Параметры.ИспользоватьЛенивуюЗагрузку);

	Текст = РаботаСChangeLog.ПолучитьТекстШаблона(Параметры.Шаблон);
	Текст = СтроковыеОперации.ЗаменитьПараметры(Текст, СтруктураПодстановки(Параметры, ТекстHTML));

	Если Параметры.ИспользоватьЛенивуюЗагрузку = Истина Тогда
		Текст = РаботаСChangeLog.ВстроитьСкриптЛенивойЗагрузки(Текст);
	КонецЕсли;

	Если Параметры.МинимизироватьHTML = Истина Тогда
		Лог.Информация("Минификация файла (удаление комментариев, лишних пробелов а так же перевода строк)");
		Текст = СтроковыеОперации.МинимизироватьHTML(Текст);
	КонецЕсли;

	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(Текст);
	ТД.Записать(Параметры.ФайлРезультат);

	Лог.Информация("Окончание конвертации файла Markdown");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собирает значения для подстановки в шаблон оформления
//
// Шаблоны рассчитаны на ChangeLog, поэтому заполняются все известные им параметры: не заданные
// подставляются пустыми, иначе в результате останутся неразрешенные подстановки вида {{Version}}.
//
// Параметры:
//  Параметры    - Структура     - структура конвертации, см. КонструкторКонвертирования
//  ТекстHTML    - Строка        - сконвертированное содержимое файла Markdown
//
// Возвращаемое значение:
//	Структура - значения для подстановки
//
Функция СтруктураПодстановки(Знач Параметры, Знач ТекстHTML)

	Заголовок = Параметры.Заголовок;
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = Параметры.ИмяПродукта;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Title", СокрЛП(Заголовок));
	Результат.Вставить("Version", "");
	Результат.Вставить("Date", "");
	Результат.Вставить("Text", ТекстHTML);
	Результат.Вставить("ProductName", Параметры.ИмяПродукта);
	Результат.Вставить("news_short_description", "");
	Результат.Вставить("news_picture", "");
	Результат.Вставить("news_url", "");

	Возврат Результат;

КонецФункции

#КонецОбласти

Лог = ПараметрыСистемы.Лог();
