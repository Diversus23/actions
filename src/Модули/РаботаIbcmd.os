#Использовать v8find

#Область ПрограммныйИнтерфейс

// Проверяет наличие утилиты ibcmd
//
// Возвращаемое значение:
//	Булево - утилита ibcmd найдена хотя бы в одной установленной версии платформы 1С
//
Функция ПроверитьУстановкуIbcmd() Экспорт

	Попытка
		Возврат ЗначениеЗаполнено(Платформа1С.ПутьКIBCMD(МаскаВерсииПоУмолчанию()));
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Маска версии платформы, используемая если версия не указана (последняя установленная)
//
// Возвращаемое значение:
//	Строка - маска версии
//
Функция МаскаВерсииПоУмолчанию() Экспорт

	Возврат "8";

КонецФункции

// Инициализирует опции подключения и авторизации для команд работы с ИБ
//
// Возвращаемое значение:
//	Массив - массив имен опций
//
Функция КонструкторОбщий() Экспорт

	Результат = КонструкторСоздания();
	Результат.Добавить("user");
	Результат.Добавить("password");
	Возврат Результат;

КонецФункции

// Инициализирует опции для создания ИБ (без авторизации пользователя ИБ)
//
// Возвращаемое значение:
//	Массив - массив имен опций
//
Функция КонструкторСоздания() Экспорт

	Результат = Новый Массив();
	Результат.Добавить("dbpath");
	Результат.Добавить("dbms");
	Результат.Добавить("dbserver");
	Результат.Добавить("dbname");
	Результат.Добавить("dbuser");
	Результат.Добавить("dbpassword");
	Результат.Добавить("v8version");
	Результат.Добавить("processpath");
	Результат.Добавить("data");
	Возврат Результат;

КонецФункции

// Инициализирует опции для команд, обновляющих конфигурацию базы данных
//
// Возвращаемое значение:
//	Массив - массив имен опций
//
Функция КонструкторОбновления() Экспорт

	Результат = КонструкторОбщий();
	Результат.Добавить("dynamic");
	Результат.Добавить("sessionterminate");
	Возврат Результат;

КонецФункции

// Инициализирует опции для команд загрузки конфигурации с последующим обновлением базы данных
//
// Возвращаемое значение:
//	Массив - массив имен опций
//
Функция КонструкторЗагрузки() Экспорт

	Результат = КонструкторОбновления();
	Результат.Добавить("noapply");
	Возврат Результат;

КонецФункции

// Добавляет в команду опции работы с ibcmd
//
// Параметры:
//  Команда - КомандаПриложения - объект описание команды
//	МассивПараметров - Массив - имена опций, которые надо зарегистрировать
//
// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Процедура ОписаниеКоманды(Команда, Знач МассивПараметров) Экспорт

	Если МассивПараметров.Найти("dbpath") <> Неопределено Тогда
		Команда.Опция("dbpath", "",
			"Каталог файловой информационной базы 1С. Указывается либо --dbpath, либо --dbms (для серверной ИБ)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("dbms") <> Неопределено Тогда
		Команда.Опция("dbms", "",
			"Тип СУБД серверной ИБ: MSSQLServer, PostgreSQL, IBMDB2, OracleDatabase. Подключение напрямую к СУБД")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("dbserver") <> Неопределено Тогда
		Команда.Опция("dbserver", "",
			"Сервер СУБД (обязательный для серверной ИБ)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("dbname") <> Неопределено Тогда
		Команда.Опция("dbname", "",
			"Имя базы данных на сервере СУБД (обязательный для серверной ИБ)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("dbuser") <> Неопределено Тогда
		Команда.Опция("dbuser", "",
			"Пользователь сервера СУБД (необязательный)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("dbpassword") <> Неопределено Тогда
		Команда.Опция("dbpassword", "",
			"Пароль пользователя сервера СУБД (необязательный)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("user") <> Неопределено Тогда
		Команда.Опция("user u", "",
			"Имя пользователя информационной базы (необязательный)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("password") <> Неопределено Тогда
		Команда.Опция("password pwd", "",
			"Пароль пользователя информационной базы (необязательный)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("v8version") <> Неопределено Тогда
		Команда.Опция("v8version", "",
			"Версия (маска версии) платформы 1С, из которой берется ibcmd. Например: 8.3.27, 8.5. "
			+ "По умолчанию - последняя установленная (необязательный)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("processpath") <> Неопределено Тогда
		Команда.Опция("processpath", "",
			"Каталог записи информация о процессе. Если процесс зависнет, то система закроет его (не обязательный)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("data") <> Неопределено Тогда
		Команда.Опция("data", "",
			"Каталог данных ibcmd. По умолчанию создается временный каталог на время выполнения команды "
			+ "(необязательный)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("noapply") <> Неопределено Тогда
		Команда.Опция("noapply", "",
			"Не выполнять обновление конфигурации базы данных после загрузки (необязательный)")
			.ТБулево();
	КонецЕсли;

	Если МассивПараметров.Найти("dynamic") <> Неопределено Тогда
		Команда.Опция("dynamic", "",
			"Динамическое обновление конфигурации БД: auto, disable, force. По умолчанию - как в ibcmd (необязательный)")
			.ТСтрока();
	КонецЕсли;

	Если МассивПараметров.Найти("sessionterminate") <> Неопределено Тогда
		Команда.Опция("sessionterminate", "",
			"Завершение активных сеансов при необходимости монопольного доступа: disable, force (необязательный)")
			.ТСтрока();
	КонецЕсли;

КонецПроцедуры
// BSLLS:CognitiveComplexity-on
// BSLLS:CyclomaticComplexity-on

// Читает опции ibcmd из команды приложения и проверяет их
//
// Параметры:
//  Команда - КомандаПриложения - объект описание команды
//	МассивПараметров - Массив - имена опций, зарегистрированных в команде
//
// Возвращаемое значение:
//	Структура - параметры команды:
//		* КаталогИБ - Строка - каталог файловой ИБ
//		* ТипСУБД - Строка - тип СУБД серверной ИБ
//		* СерверСУБД - Строка - сервер СУБД
//		* ИмяБД - Строка - имя базы данных на сервере СУБД
//		* ПользовательСУБД - Строка - пользователь СУБД
//		* ПарольСУБД - Строка - пароль пользователя СУБД
//		* Пользователь - Строка - пользователь ИБ
//		* Пароль - Строка - пароль пользователя ИБ
//		* ВерсияПлатформы - Строка - маска версии платформы
//		* КаталогКонтроляОткрытыхПриложений - Строка - каталог контроля процессов
//		* КаталогДанных - Строка - каталог данных ibcmd
//		* НеОбновлять - Булево - не выполнять обновление конфигурации БД после загрузки
//		* ДинамическоеОбновление - Строка - режим динамического обновления
//		* ЗавершениеСеансов - Строка - режим завершения сеансов
//
// BSLLS:CognitiveComplexity-off
Функция ПрочитатьПараметры(Знач Команда, Знач МассивПараметров) Экспорт

	ЧтениеОпций = Новый ЧтениеОпцийКоманды(Команда);
	ВыводОтладочнойИнформации = ЧтениеОпций.ЗначениеОпции("verbose");
	ПараметрыСистемы.УстановитьРежимОтладки(ВыводОтладочнойИнформации);

	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("КаталогИБ", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "dbpath"));
	ПараметрыКоманды.Вставить("ТипСУБД", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "dbms"));
	ПараметрыКоманды.Вставить("СерверСУБД", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "dbserver"));
	ПараметрыКоманды.Вставить("ИмяБД", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "dbname"));
	ПараметрыКоманды.Вставить("ПользовательСУБД", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "dbuser"));
	ПараметрыКоманды.Вставить("ПарольСУБД", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "dbpassword", Ложь));
	ПараметрыКоманды.Вставить("Пользователь", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "user"));
	ПараметрыКоманды.Вставить("Пароль", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "password", Ложь));
	ПараметрыКоманды.Вставить("ВерсияПлатформы", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "v8version"));
	ПараметрыКоманды.Вставить("КаталогКонтроляОткрытыхПриложений",
		ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "processpath"));
	ПараметрыКоманды.Вставить("КаталогДанных", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "data"));
	ПараметрыКоманды.Вставить("ДинамическоеОбновление", ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "dynamic"));
	ПараметрыКоманды.Вставить("ЗавершениеСеансов",
		ЗначениеСтрокой(ЧтениеОпций, МассивПараметров, "sessionterminate"));

	НеОбновлять = Ложь;
	Если МассивПараметров.Найти("noapply") <> Неопределено Тогда
		НеОбновлять = ЧтениеОпций.ЗначениеОпции("noapply") = Истина;
	КонецЕсли;
	ПараметрыКоманды.Вставить("НеОбновлять", НеОбновлять);

	// В шаблонах CI пустой пользователь может передаваться строкой "null" или пустыми кавычками
	Если ПараметрыКоманды.Пользователь = """"""
		ИЛИ ПараметрыКоманды.Пользователь = "''"
		ИЛИ НРег(ПараметрыКоманды.Пользователь) = "null" Тогда
		ПараметрыКоманды.Пользователь = "";
	КонецЕсли;
	Если ПустаяСтрока(ПараметрыКоманды.Пользователь) Тогда
		ПараметрыКоманды.Пароль = "";
	КонецЕсли;

	Если МассивПараметров.Найти("dbpath") <> Неопределено Тогда
		ПроверитьПараметрыПодключения(ПараметрыКоманды);
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыКоманды.ДинамическоеОбновление) Тогда
		ПараметрыКоманды.ДинамическоеОбновление = ПроверитьЗначениеИзСписка(ПараметрыКоманды.ДинамическоеОбновление,
			"auto,disable,force", "--dynamic");
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыКоманды.ЗавершениеСеансов) Тогда
		ПараметрыКоманды.ЗавершениеСеансов = ПроверитьЗначениеИзСписка(ПараметрыКоманды.ЗавершениеСеансов,
			"disable,force", "--sessionterminate");
	КонецЕсли;

	Возврат ПараметрыКоманды;

КонецФункции
// BSLLS:CognitiveComplexity-on

// Проверяет, что значение входит в список допустимых (без учета регистра).
// Если не входит, то завершает работу с ошибкой.
//
// Параметры:
//  Значение - Строка - проверяемое значение
//  Допустимые - Строка - допустимые значения через запятую
//  ИмяОпции - Строка - имя опции для текста ошибки
//
// Возвращаемое значение:
//	Строка - допустимое значение в том написании, в котором оно указано в списке
//
Функция ПроверитьЗначениеИзСписка(Знач Значение, Знач Допустимые, Знач ИмяОпции) Экспорт

	Для Каждого Допустимое Из СтрРазделить(Допустимые, ",", Ложь) Цикл
		Если НРег(СокрЛП(Значение)) = НРег(Допустимое) Тогда
			Возврат Допустимое;
		КонецЕсли;
	КонецЦикла;

	ОбщегоНазначения.ЗавершениеРаботыОшибка("Недопустимое значение ""%1"" опции %2. Допустимые значения: %3",
		Значение, ИмяОпции, СтрЗаменить(Допустимые, ",", ", "));

	Возврат "";

КонецФункции

// Проверяет существование каталога. Если каталога нет, то завершает работу с ошибкой.
//
// Параметры:
//  Путь - Строка - путь к каталогу
//  ИмяОпции - Строка - имя опции для текста ошибки
//
Процедура ПроверитьСуществованиеКаталога(Знач Путь, Знач ИмяОпции) Экспорт

	Если НЕ ФайловыеОперации.КаталогСуществует(Путь) Тогда
		ОбщегоНазначения.ЗавершениеРаботыОшибка("Каталог ""%1"" (%2) не существует", Путь, ИмяОпции);
	КонецЕсли;

КонецПроцедуры

// Проверяет существование файла. Если файла нет, то завершает работу с ошибкой.
//
// Параметры:
//  Путь - Строка - путь к файлу
//  ИмяОпции - Строка - имя опции для текста ошибки
//
Процедура ПроверитьСуществованиеФайла(Знач Путь, Знач ИмяОпции) Экспорт

	Если НЕ ФайловыеОперации.ФайлСуществует(Путь) Тогда
		ОбщегоНазначения.ЗавершениеРаботыОшибка("Файл ""%1"" (%2) не существует", Путь, ИмяОпции);
	КонецЕсли;

КонецПроцедуры

// Выполняет операцию команды с информационной базой через ibcmd.
// Создает и инициализирует МенеджерIbcmd, вызывает у объекта операции метод
// ВыполнитьОперацию(МенеджерIbcmd, ПараметрыКоманды) и освобождает ресурсы менеджера.
// При ошибке завершает работу приложения с кодом 1.
//
// Параметры:
//  Операция - Произвольный - объект команды с экспортным методом ВыполнитьОперацию
//  ПараметрыКоманды - Структура - см. ПрочитатьПараметры
//  ОписаниеОшибки - Строка - текст, предваряющий описание ошибки
//
Процедура ВыполнитьОперацию(Знач Операция, Знач ПараметрыКоманды, Знач ОписаниеОшибки) Экспорт

	МенеджерIbcmd = Новый МенеджерIbcmd();
	Попытка
		МенеджерIbcmd.Инициализация(ПараметрыКоманды);
		Операция.ВыполнитьОперацию(МенеджерIbcmd, ПараметрыКоманды);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		МенеджерIbcmd.Деструктор();
		ОбщегоНазначения.ЗавершениеРаботыОшибка("%1: %2", ОписаниеОшибки, ТекстОшибки);
	КонецПопытки;
	МенеджерIbcmd.Деструктор();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеСтрокой(Знач ЧтениеОпций, Знач МассивПараметров, Знач ИмяОпции, Знач Сокращать = Истина)

	Если МассивПараметров.Найти(ИмяОпции) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = ЧтениеОпций.ЗначениеОпции(ИмяОпции);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Значение = Строка(Значение);
	Если Сокращать Тогда
		Значение = СокрЛП(Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ПроверитьПараметрыПодключения(ПараметрыКоманды)

	ЭтоФайловая = ЗначениеЗаполнено(ПараметрыКоманды.КаталогИБ);
	ЭтоСерверная = ЗначениеЗаполнено(ПараметрыКоманды.ТипСУБД);

	Если ЭтоФайловая И ЭтоСерверная Тогда
		ОбщегоНазначения.ЗавершениеРаботыОшибка(
			"Укажите что-то одно: --dbpath (файловая ИБ) или --dbms (серверная ИБ), а не оба сразу");
	КонецЕсли;

	Если НЕ ЭтоФайловая И НЕ ЭтоСерверная Тогда
		ОбщегоНазначения.ЗавершениеРаботыОшибка(
			"Не задано подключение к ИБ: укажите --dbpath (файловая ИБ) или --dbms (серверная ИБ)");
	КонецЕсли;

	Если ЭтоСерверная Тогда
		ПараметрыКоманды.ТипСУБД = ПроверитьЗначениеИзСписка(ПараметрыКоманды.ТипСУБД,
			"MSSQLServer,PostgreSQL,IBMDB2,OracleDatabase", "--dbms");
		Если НЕ ЗначениеЗаполнено(ПараметрыКоманды.СерверСУБД) Тогда
			ОбщегоНазначения.ЗавершениеРаботыОшибка("Для серверной ИБ необходимо указать --dbserver");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПараметрыКоманды.ИмяБД) Тогда
			ОбщегоНазначения.ЗавершениеРаботыОшибка("Для серверной ИБ необходимо указать --dbname");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
