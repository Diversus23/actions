#Область ПрограммныйИнтерфейс

// Процедура - устанавливает описание команды
//
// Параметры:
//  Команда    - КомандаПриложения     - объект описание команды
//
Процедура ОписаниеКоманды(Команда) Экспорт

	РаботаIbcmd.ОписаниеКоманды(Команда, РаботаIbcmd.КонструкторОбновления());

	Команда.Опция("project j", "",
		"Каталог, содержащий проект 1C:Enterprise Development Tools (обязательный)")
		.ТСтрока();

	Команда.Опция("extension", "",
		"Имя расширения. Если указано, то проект EDT собирается как расширение с этим именем (необязательный)")
		.ТСтрока();

	Команда.Опция("create", "",
		"Создать информационную базу с нуля из проекта EDT. Нельзя использовать вместе с --extension (необязательный)")
		.ТБулево();

	Команда.Опция("path p", "",
		"Каталог, куда сохранить промежуточную выгрузку проекта в XML. По умолчанию - временный каталог. "
		+ "Важно! Каталог будет очищен в процессе работы команды (необязательный)")
		.ТСтрока();

	Команда.Опция("workspace w", "",
		"Каталог рабочего пространства для запуска 1C:Enterprise Development Tools (необязательный)")
		.ТСтрока();

	Команда.Опция("edtversion e", "",
		"Версия EDT для экспорта. Пример: ""2021.1.5"". "
		+ "Список установленных версий можно узнать набрав ""oscript actions.os edt versions"" (необязательный)")
		.ТСтрока();

КонецПроцедуры // ОписаниеКоманды()

// Процедура - запускает выполнение команды
//
// Параметры:
//  Команда    - КомандаПриложения     - объект  описание команды
//
Процедура ВыполнитьКоманду(Знач Команда) Экспорт

	ПараметрыКоманды = ПолучитьСтруктуруПараметров(Команда);
	РаботаIbcmd.ВыполнитьОперацию(ЭтотОбъект, ПараметрыКоманды, "Ошибка сборки информационной базы из проекта EDT");

КонецПроцедуры // ВыполнитьКоманду()

// Процедура - выполняет операцию с информационной базой.
// Экспорт EDT выполняется после инициализации менеджера, чтобы при отсутствии ibcmd
// не тратить время на экспорт.
//
// Параметры:
//  МенеджерIbcmd - МенеджерIbcmd - инициализированный менеджер ibcmd
//  ПараметрыКоманды - Структура - параметры команды
//
Процедура ВыполнитьОперацию(Знач МенеджерIbcmd, Знач ПараметрыКоманды) Экспорт

	КаталогXML = ПараметрыКоманды.КаталогXML;
	ВременныйКаталогXML = НЕ ЗначениеЗаполнено(КаталогXML);
	Если ВременныйКаталогXML Тогда
		КаталогXML = ФайловыеОперации.ОбеспечитьВременныйКаталог();
	КонецЕсли;

	Попытка
		ЭкспортироватьПроектEDT(ПараметрыКоманды, КаталогXML);
		ЗагрузитьВИнформационнуюБазу(МенеджерIbcmd, ПараметрыКоманды, КаталогXML);
	Исключение
		УдалитьВременныйКаталог(ВременныйКаталогXML, КаталогXML);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременныйКаталог(ВременныйКаталогXML, КаталогXML);

КонецПроцедуры

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСтруктуруПараметров(Знач Команда)

	ПараметрыКоманды = РаботаIbcmd.ПрочитатьПараметры(Команда, РаботаIbcmd.КонструкторОбновления());

	ЧтениеОпций = Новый ЧтениеОпцийКоманды(Команда);
	ПараметрыКоманды.Вставить("КаталогПроекта", ЧтениеОпций.ЗначениеОпции("project", Истина));
	ПараметрыКоманды.Вставить("ИмяРасширения", ЗначениеСтрокой(ЧтениеОпций.ЗначениеОпции("extension")));
	ПараметрыКоманды.Вставить("СоздатьИБ", ЧтениеОпций.ЗначениеОпции("create") = Истина);
	ПараметрыКоманды.Вставить("КаталогXML", ЗначениеСтрокой(ЧтениеОпций.ЗначениеОпции("path")));
	ПараметрыКоманды.Вставить("КаталогПространства", ЗначениеСтрокой(ЧтениеОпций.ЗначениеОпции("workspace")));
	ПараметрыКоманды.Вставить("ВерсияEDT", ЗначениеСтрокой(ЧтениеОпций.ЗначениеОпции("edtversion")));

	РаботаIbcmd.ПроверитьСуществованиеКаталога(ПараметрыКоманды.КаталогПроекта, "--project");

	Если ПараметрыКоманды.СоздатьИБ И ЗначениеЗаполнено(ПараметрыКоманды.ИмяРасширения) Тогда
		ОбщегоНазначения.ЗавершениеРаботыОшибка(
			"Опцию --create нельзя использовать вместе с --extension: сначала создайте ИБ из конфигурации");
	КонецЕсли;

	Возврат ПараметрыКоманды;

КонецФункции // ПолучитьСтруктуруПараметров()

Процедура ЭкспортироватьПроектEDT(Знач ПараметрыКоманды, Знач КаталогXML)

	ПараметрыЭкспорта = Новый Структура;
	ПараметрыЭкспорта.Вставить("КаталогПроекта", ПараметрыКоманды.КаталогПроекта);
	ПараметрыЭкспорта.Вставить("КаталогЭкспорта", КаталогXML);
	ПараметрыЭкспорта.Вставить("КаталогПространства", ПараметрыКоманды.КаталогПространства);
	ПараметрыЭкспорта.Вставить("ВерсияEDT", ПараметрыКоманды.ВерсияEDT);
	ПараметрыЭкспорта.Вставить("КаталогКонтроляОткрытыхПриложений",
		ПараметрыКоманды.КаталогКонтроляОткрытыхПриложений);

	РаботаEDT.ЭкспортВXML1CEdtCli(ПараметрыЭкспорта);

КонецПроцедуры

Процедура ЗагрузитьВИнформационнуюБазу(Знач МенеджерIbcmd, Знач ПараметрыКоманды, Знач КаталогXML)

	Если ПараметрыКоманды.СоздатьИБ Тогда
		МенеджерIbcmd.СоздатьИБ(КаталогXML, Истина);
		Возврат;
	КонецЕсли;

	МенеджерIbcmd.ЗагрузитьКонфигурациюИзXML(КаталогXML, ПараметрыКоманды.ИмяРасширения);
	МенеджерIbcmd.ОбновитьКонфигурациюБД(ПараметрыКоманды.ИмяРасширения,
		ПараметрыКоманды.ДинамическоеОбновление,
		ПараметрыКоманды.ЗавершениеСеансов);

КонецПроцедуры

Процедура УдалитьВременныйКаталог(Знач ЭтоВременныйКаталог, Знач Каталог)

	Если ЭтоВременныйКаталог Тогда
		ФайловыеОперации.БезопасноУдалитьФайл(Каталог);
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеСтрокой(Знач Значение)

	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Значение), "");

КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
