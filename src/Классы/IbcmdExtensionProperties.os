#Область ПрограммныйИнтерфейс

// Процедура - устанавливает описание команды
//
// Параметры:
//  Команда    - КомандаПриложения     - объект описание команды
//
Процедура ОписаниеКоманды(Команда) Экспорт

	РаботаIbcmd.ОписаниеКоманды(Команда, РаботаIbcmd.КонструкторОбщий());

	Команда.Опция("name extension n", "",
		"Имя расширения (обязательный)")
		.ТСтрока();

	Команда.Опция("active", "",
		"Активность расширения: yes, no (необязательный)")
		.ТСтрока();

	Команда.Опция("safemode", "",
		"Безопасный режим: yes, no (необязательный)")
		.ТСтрока();

	Команда.Опция("securityprofile", "",
		"Имя профиля безопасности (необязательный)")
		.ТСтрока();

	Команда.Опция("unsafeprotection", "",
		"Защита от опасных действий: yes, no (необязательный)")
		.ТСтрока();

	Команда.Опция("usedindistributedib", "",
		"Используется в распределенной информационной базе: yes, no (необязательный)")
		.ТСтрока();

	Команда.Опция("scope", "",
		"Область действия расширения: infobase, data-separation (необязательный)")
		.ТСтрока();

КонецПроцедуры // ОписаниеКоманды()

// Процедура - запускает выполнение команды
//
// Параметры:
//  Команда    - КомандаПриложения     - объект  описание команды
//
Процедура ВыполнитьКоманду(Знач Команда) Экспорт

	ПараметрыКоманды = РаботаIbcmd.ПрочитатьПараметры(Команда, РаботаIbcmd.КонструкторОбщий());
	ЧтениеОпций = Новый ЧтениеОпцийКоманды(Команда);
	ПараметрыКоманды.Вставить("ИмяРасширения", ЧтениеОпций.ЗначениеОпции("name", Истина));

	Свойства = Новый Соответствие;
	ДобавитьСвойство(Свойства, ЧтениеОпций, "active", "active", "yes,no");
	ДобавитьСвойство(Свойства, ЧтениеОпций, "safemode", "safe-mode", "yes,no");
	ДобавитьСвойство(Свойства, ЧтениеОпций, "securityprofile", "security-profile-name");
	ДобавитьСвойство(Свойства, ЧтениеОпций, "unsafeprotection", "unsafe-action-protection", "yes,no");
	ДобавитьСвойство(Свойства, ЧтениеОпций, "usedindistributedib", "used-in-distributed-infobase", "yes,no");
	ДобавитьСвойство(Свойства, ЧтениеОпций, "scope", "scope", "infobase,data-separation");

	Если Свойства.Количество() = 0 Тогда
		ОбщегоНазначения.ЗавершениеРаботыОшибка("Не задано ни одно свойство расширения для изменения");
	КонецЕсли;
	ПараметрыКоманды.Вставить("Свойства", Свойства);

	РаботаIbcmd.ВыполнитьОперацию(ЭтотОбъект, ПараметрыКоманды,
		СтрШаблон("Ошибка изменения свойств расширения %1", ПараметрыКоманды.ИмяРасширения));

КонецПроцедуры // ВыполнитьКоманду()

// Процедура - выполняет операцию с информационной базой
//
// Параметры:
//  МенеджерIbcmd - МенеджерIbcmd - инициализированный менеджер ibcmd
//  ПараметрыКоманды - Структура - параметры команды
//
Процедура ВыполнитьОперацию(Знач МенеджерIbcmd, Знач ПараметрыКоманды) Экспорт

	МенеджерIbcmd.ИзменитьСвойстваРасширения(ПараметрыКоманды.ИмяРасширения, ПараметрыКоманды.Свойства);

КонецПроцедуры

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСвойство(Свойства, Знач ЧтениеОпций, Знач ИмяОпции, Знач ИмяСвойства, Знач Допустимые = "")

	Значение = ЧтениеОпций.ЗначениеОпции(ИмяОпции);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Допустимые) Тогда
		Значение = РаботаIbcmd.ПроверитьЗначениеИзСписка(Значение, Допустимые, "--" + ИмяОпции);
	КонецЕсли;

	Свойства.Вставить(ИмяСвойства, Значение);

КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции
