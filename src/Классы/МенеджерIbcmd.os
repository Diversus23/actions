#Использовать v8find

// Лог модуля
Перем Лог;
// Путь к исполняемому файлу ibcmd
Перем ПутьКIbcmd;
// Массив аргументов подключения к ИБ (см. НовыйАргумент)
Перем АргументыПодключения;
// Массив аргументов авторизации пользователя ИБ (см. НовыйАргумент)
Перем АргументыАвторизации;
// Каталог данных ibcmd
Перем КаталогДанных;
// Признак, что каталог данных временный и его надо удалить
Перем ВременныйКаталогДанных;
// Каталог контроля открытых приложений
Перем КаталогКонтроляОткрытыхПриложений;
// Вывод последней выполненной команды ibcmd
Перем ВыводКоманды;

#Область ПрограммныйИнтерфейс

// Инициализирует МенеджерIbcmd. Надо вызывать всегда после создания объекта
//
// Параметры:
//  Параметры - Структура - см. РаботаIbcmd.ПрочитатьПараметры
//
Процедура Инициализация(Знач Параметры) Экспорт

	МаскаВерсии = Параметры.ВерсияПлатформы;
	Если НЕ ЗначениеЗаполнено(МаскаВерсии) Тогда
		МаскаВерсии = РаботаIbcmd.МаскаВерсииПоУмолчанию();
	КонецЕсли;

	ПутьКIbcmd = Платформа1С.ПутьКIBCMD(МаскаВерсии);
	Если НЕ ЗначениеЗаполнено(ПутьКIbcmd) Тогда
		ВызватьИсключение СтрШаблон("Не найдена утилита ibcmd для версии платформы ""%1"". "
			+ "Проверьте, что платформа установлена вместе с компонентом ibcmd, или укажите --v8version",
			МаскаВерсии);
	КонецЕсли;
	Лог.Информация("Используется ibcmd: %1", ПутьКIbcmd);

	КаталогКонтроляОткрытыхПриложений = Параметры.КаталогКонтроляОткрытыхПриложений;

	АргументыПодключения = Новый Массив;
	Если ЗначениеЗаполнено(Параметры.КаталогИБ) Тогда
		АргументыПодключения.Добавить(НовыйАргумент("--db-path",
			ФайловыеОперации.АбсолютныйПуть(Параметры.КаталогИБ)));
	Иначе
		АргументыПодключения.Добавить(НовыйАргумент("--dbms", Параметры.ТипСУБД));
		АргументыПодключения.Добавить(НовыйАргумент("--db-server", Параметры.СерверСУБД));
		АргументыПодключения.Добавить(НовыйАргумент("--db-name", Параметры.ИмяБД));
		Если ЗначениеЗаполнено(Параметры.ПользовательСУБД) Тогда
			АргументыПодключения.Добавить(НовыйАргумент("--db-user", Параметры.ПользовательСУБД));
		КонецЕсли;
		Если ЗначениеЗаполнено(Параметры.ПарольСУБД) Тогда
			АргументыПодключения.Добавить(НовыйАргумент("--db-pwd", Параметры.ПарольСУБД, Истина));
		КонецЕсли;
	КонецЕсли;

	АргументыАвторизации = Новый Массив;
	Если ЗначениеЗаполнено(Параметры.Пользователь) Тогда
		АргументыАвторизации.Добавить(НовыйАргумент("--user", Параметры.Пользователь));
		Если ЗначениеЗаполнено(Параметры.Пароль) Тогда
			АргументыАвторизации.Добавить(НовыйАргумент("--password", Параметры.Пароль, Истина));
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.КаталогДанных) Тогда
		КаталогДанных = ФайловыеОперации.АбсолютныйПуть(Параметры.КаталогДанных);
		ВременныйКаталогДанных = Ложь;
	КонецЕсли;

КонецПроцедуры

// Освобождает ресурсы менеджера (удаляет временный каталог данных ibcmd).
// Надо вызывать всегда после того, как объект перестал быть нужен.
//
Процедура Деструктор() Экспорт

	Если ВременныйКаталогДанных = Истина И ЗначениеЗаполнено(КаталогДанных) Тогда
		Попытка
			ВременныеФайлы.УдалитьФайл(КаталогДанных);
		Исключение
			Лог.Отладка("Не удалось удалить временный каталог данных ibcmd %1: %2", КаталогДанных, ОписаниеОшибки());
		КонецПопытки;
		КаталогДанных = Неопределено;
		ВременныйКаталогДанных = Ложь;
	КонецЕсли;

КонецПроцедуры

// Создает информационную базу: пустую или из шаблона
//
// Параметры:
//  ПутьКШаблону - Строка - каталог с XML-файлами конфигурации, cf-файл или dt-файл. Пусто - пустая ИБ
//  Обновить - Булево - обновить конфигурацию БД после загрузки конфигурации (для каталога XML и cf-файла)
//  Локаль - Строка - имя локали ИБ
//  СмещениеДат - Число, Неопределено - смещение дат (для MSSQL). Неопределено - не передавать
//
Процедура СоздатьИБ(Знач ПутьКШаблону = "", Знач Обновить = Истина, Знач Локаль = "",
	Знач СмещениеДат = Неопределено) Экспорт

	Аргументы = Новый Массив;
	Если ЗначениеЗаполнено(Локаль) Тогда
		Аргументы.Добавить(НовыйАргумент("--locale", Локаль));
	КонецЕсли;
	Если СмещениеДат <> Неопределено Тогда
		Аргументы.Добавить(НовыйАргумент("--date-offset", Формат(СмещениеДат, "ЧН=0; ЧГ=0")));
	КонецЕсли;
	Аргументы.Добавить(НовыйАргумент("--create-database"));

	Если ЗначениеЗаполнено(ПутьКШаблону) Тогда
		Шаблон = Новый Файл(ПутьКШаблону);
		Если НЕ Шаблон.Существует() Тогда
			ВызватьИсключение СтрШаблон("Шаблон ""%1"" не существует", ПутьКШаблону);
		КонецЕсли;
		Если Шаблон.ЭтоКаталог() Тогда
			Аргументы.Добавить(НовыйАргумент("--import", ФайловыеОперации.АбсолютныйПуть(ПутьКШаблону)));
			ЗагружаетсяКонфигурация = Истина;
		ИначеЕсли НРег(Шаблон.Расширение) = ".cf" Тогда
			Аргументы.Добавить(НовыйАргумент("--load", ФайловыеОперации.АбсолютныйПуть(ПутьКШаблону)));
			ЗагружаетсяКонфигурация = Истина;
		ИначеЕсли НРег(Шаблон.Расширение) = ".dt" Тогда
			Аргументы.Добавить(НовыйАргумент("--restore", ФайловыеОперации.АбсолютныйПуть(ПутьКШаблону)));
			ЗагружаетсяКонфигурация = Ложь;
		Иначе
			ВызватьИсключение СтрШаблон("Шаблон ""%1"" должен быть каталогом XML, cf-файлом или dt-файлом",
				ПутьКШаблону);
		КонецЕсли;
		Если ЗагружаетсяКонфигурация И Обновить Тогда
			Аргументы.Добавить(НовыйАргумент("--apply"));
		КонецЕсли;
	КонецЕсли;
	Аргументы.Добавить(НовыйАргумент("--force"));

	Лог.Информация("Создание информационной базы");
	ВыполнитьКоманду("infobase create", Аргументы, Ложь);
	Лог.Информация("Создание информационной базы завершено");

КонецПроцедуры

// Загружает конфигурацию или расширение из XML-файлов
//
// Параметры:
//  Каталог - Строка - каталог с XML-файлами конфигурации 1С
//  ИмяРасширения - Строка - имя расширения. Пусто - основная конфигурация
//
Процедура ЗагрузитьКонфигурациюИзXML(Знач Каталог, Знач ИмяРасширения = "") Экспорт

	Аргументы = АргументыРасширения(ИмяРасширения);
	Аргументы.Добавить(НовыйАргумент("", ФайловыеОперации.АбсолютныйПуть(Каталог)));

	Лог.Информация("Загрузка %1 из XML-файлов <%2>", ПредставлениеОбъекта(ИмяРасширения), Каталог);
	ВыполнитьКоманду("infobase config import", Аргументы);
	Лог.Информация("Загрузка из XML-файлов завершена");

КонецПроцедуры

// Выгружает конфигурацию или расширение в XML-файлы. Каталог должен быть пустым.
//
// Параметры:
//  Каталог - Строка - каталог для выгрузки
//  ИмяРасширения - Строка - имя расширения. Пусто - основная конфигурация
//
Процедура ВыгрузитьКонфигурациюВXML(Знач Каталог, Знач ИмяРасширения = "") Экспорт

	Аргументы = АргументыРасширения(ИмяРасширения);
	Аргументы.Добавить(НовыйАргумент("", ФайловыеОперации.АбсолютныйПуть(Каталог)));

	Лог.Информация("Выгрузка %1 в XML-файлы <%2>", ПредставлениеОбъекта(ИмяРасширения), Каталог);
	ВыполнитьКоманду("infobase config export", Аргументы);
	Лог.Информация("Выгрузка в XML-файлы завершена");

КонецПроцедуры

// Загружает конфигурацию (cf) или расширение (cfe) из файла
//
// Параметры:
//  ПутьКФайлу - Строка - путь к cf- или cfe-файлу
//  ИмяРасширения - Строка - имя расширения. Пусто - основная конфигурация
//
Процедура ЗагрузитьКонфигурацию(Знач ПутьКФайлу, Знач ИмяРасширения = "") Экспорт

	Аргументы = АргументыРасширения(ИмяРасширения);
	Аргументы.Добавить(НовыйАргумент("--force"));
	Аргументы.Добавить(НовыйАргумент("", ФайловыеОперации.АбсолютныйПуть(ПутьКФайлу)));

	Лог.Информация("Загрузка %1 из файла <%2>", ПредставлениеОбъекта(ИмяРасширения), ПутьКФайлу);
	ВыполнитьКоманду("infobase config load", Аргументы);
	Лог.Информация("Загрузка из файла завершена");

КонецПроцедуры

// Выгружает конфигурацию (cf) или расширение (cfe) в файл
//
// Параметры:
//  ПутьКФайлу - Строка - путь к cf- или cfe-файлу
//  ИмяРасширения - Строка - имя расширения. Пусто - основная конфигурация
//  КонфигурацияБД - Булево - выгрузить конфигурацию базы данных, а не основную конфигурацию
//
Процедура ВыгрузитьКонфигурацию(Знач ПутьКФайлу, Знач ИмяРасширения = "", Знач КонфигурацияБД = Ложь) Экспорт

	Аргументы = АргументыРасширения(ИмяРасширения);
	Если КонфигурацияБД Тогда
		Аргументы.Добавить(НовыйАргумент("--db"));
	КонецЕсли;
	Аргументы.Добавить(НовыйАргумент("", ФайловыеОперации.АбсолютныйПуть(ПутьКФайлу)));

	Лог.Информация("Выгрузка %1 в файл <%2>", ПредставлениеОбъекта(ИмяРасширения), ПутьКФайлу);
	ВыполнитьКоманду("infobase config save", Аргументы);
	Лог.Информация("Выгрузка в файл завершена");

КонецПроцедуры

// Обновляет конфигурацию базы данных
//
// Параметры:
//  ИмяРасширения - Строка - имя расширения. Пусто - основная конфигурация
//  ДинамическоеОбновление - Строка - auto, disable, force. Пусто - не передавать
//  ЗавершениеСеансов - Строка - disable, force. Пусто - не передавать
//
Процедура ОбновитьКонфигурациюБД(Знач ИмяРасширения = "", Знач ДинамическоеОбновление = "",
	Знач ЗавершениеСеансов = "") Экспорт

	Аргументы = АргументыРасширения(ИмяРасширения);
	Аргументы.Добавить(НовыйАргумент("--force"));
	Если ЗначениеЗаполнено(ДинамическоеОбновление) Тогда
		Аргументы.Добавить(НовыйАргумент("--dynamic", ДинамическоеОбновление));
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗавершениеСеансов) Тогда
		Аргументы.Добавить(НовыйАргумент("--session-terminate", ЗавершениеСеансов));
	КонецЕсли;

	Лог.Информация("Обновление конфигурации базы данных (%1)", ПредставлениеОбъекта(ИмяРасширения));
	ВыполнитьКоманду("infobase config apply", Аргументы);
	Лог.Информация("Обновление конфигурации базы данных завершено");

КонецПроцедуры

// Проверяет конфигурацию или расширение
//
// Параметры:
//  ИмяРасширения - Строка - имя расширения. Пусто - основная конфигурация
//
Процедура ПроверитьКонфигурацию(Знач ИмяРасширения = "") Экспорт

	Аргументы = АргументыРасширения(ИмяРасширения);
	Аргументы.Добавить(НовыйАргумент("--force"));

	Лог.Информация("Проверка %1", ПредставлениеОбъекта(ИмяРасширения));
	ВыполнитьКоманду("infobase config check", Аргументы);
	Лог.Информация("Проверка завершена");

КонецПроцедуры

// Выгружает данные информационной базы в dt-файл
//
// Параметры:
//  ПутьКФайлу - Строка - путь к dt-файлу
//
Процедура ВыгрузитьДанные(Знач ПутьКФайлу) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить(НовыйАргумент("", ФайловыеОперации.АбсолютныйПуть(ПутьКФайлу)));

	Лог.Информация("Выгрузка информационной базы в файл <%1>", ПутьКФайлу);
	ВыполнитьКоманду("infobase dump", Аргументы);
	Лог.Информация("Выгрузка информационной базы завершена");

КонецПроцедуры

// Загружает данные информационной базы из dt-файла
//
// Параметры:
//  ПутьКФайлу - Строка - путь к dt-файлу
//  СоздатьБД - Булево - создать базу данных в случае отсутствия
//
Процедура ЗагрузитьДанные(Знач ПутьКФайлу, Знач СоздатьБД = Ложь) Экспорт

	Аргументы = Новый Массив;
	Если СоздатьБД Тогда
		Аргументы.Добавить(НовыйАргумент("--create-database"));
	КонецЕсли;
	Аргументы.Добавить(НовыйАргумент("--force"));
	Аргументы.Добавить(НовыйАргумент("", ФайловыеОперации.АбсолютныйПуть(ПутьКФайлу)));

	Лог.Информация("Загрузка информационной базы из файла <%1>", ПутьКФайлу);
	ВыполнитьКоманду("infobase restore", Аргументы);
	Лог.Информация("Загрузка информационной базы завершена");

КонецПроцедуры

// Получает список расширений информационной базы
//
// Возвращаемое значение:
//	Строка - вывод ibcmd со списком расширений
//
Функция СписокРасширений() Экспорт

	ВыполнитьКоманду("infobase config extension list", Новый Массив);
	Возврат ВыводКоманды;

КонецФункции

// Удаляет расширение
//
// Параметры:
//  ИмяРасширения - Строка - имя расширения
//
Процедура УдалитьРасширение(Знач ИмяРасширения) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить(НовыйАргумент("--name", ИмяРасширения));

	Лог.Информация("Удаление расширения %1", ИмяРасширения);
	ВыполнитьКоманду("infobase config extension delete", Аргументы);
	Лог.Информация("Удаление расширения завершено");

КонецПроцедуры

// Удаляет все расширения
//
Процедура УдалитьВсеРасширения() Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить(НовыйАргумент("--all"));

	Лог.Информация("Удаление всех расширений");
	ВыполнитьКоманду("infobase config extension delete", Аргументы);
	Лог.Информация("Удаление всех расширений завершено");

КонецПроцедуры

// Изменяет свойства расширения
//
// Параметры:
//  ИмяРасширения - Строка - имя расширения
//  Свойства - Соответствие - ключ - имя ключа ibcmd без "--" (active, safe-mode, scope ...), значение - Строка
//
Процедура ИзменитьСвойстваРасширения(Знач ИмяРасширения, Знач Свойства) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить(НовыйАргумент("--name", ИмяРасширения));
	Для Каждого КлючЗначение Из Свойства Цикл
		Аргументы.Добавить(НовыйАргумент("--" + КлючЗначение.Ключ, КлючЗначение.Значение));
	КонецЦикла;

	Лог.Информация("Изменение свойств расширения %1", ИмяРасширения);
	ВыполнитьКоманду("infobase config extension update", Аргументы);
	Лог.Информация("Изменение свойств расширения завершено");

КонецПроцедуры

// Возвращает вывод последней выполненной команды ibcmd
//
// Возвращаемое значение:
//	Строка - вывод команды
//
Функция ВыводПоследнейКоманды() Экспорт

	Возврат ВыводКоманды;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьКоманду(Знач Режим, Знач Аргументы, Знач САвторизацией = Истина)

	Если НЕ ЗначениеЗаполнено(КаталогДанных) Тогда
		КаталогДанных = ВременныеФайлы.СоздатьКаталог();
		ВременныйКаталогДанных = Истина;
	КонецЕсли;

	ВсеАргументы = Новый Массив;
	Для Каждого ЧастьРежима Из СтрРазделить(Режим, " ", Ложь) Цикл
		ВсеАргументы.Добавить(НовыйАргумент(ЧастьРежима));
	КонецЦикла;
	ДобавитьВМассив(ВсеАргументы, АргументыПодключения);
	ВсеАргументы.Добавить(НовыйАргумент("--data", КаталогДанных));
	Если САвторизацией Тогда
		ДобавитьВМассив(ВсеАргументы, АргументыАвторизации);
	КонецЕсли;
	ДобавитьВМассив(ВсеАргументы, Аргументы);

	Тексты = Новый Массив;
	Представления = Новый Массив;
	Для Каждого Аргумент Из ВсеАргументы Цикл
		Тексты.Добавить(Аргумент.Текст);
		Представления.Добавить(Аргумент.Представление);
	КонецЦикла;

	ПредставлениеКоманды = ЭкранироватьЗначение(ПутьКIbcmd) + " " + СтрСоединить(Представления, " ");
	Лог.Информация("Выполняю: %1", ПредставлениеКоманды);

	Процесс = Новый КонтролируемыйПроцесс();
	Процесс.УстановитьКоманду(ПутьКIbcmd);
	Процесс.ДобавитьПараметры(Тексты);
	Процесс.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
	Процесс.УстановитьКодировкуВывода(КодировкаТекста.UTF8);
	Процесс.УстановитьКаталогКонтроляОткрытыхПриложений(КаталогКонтроляОткрытыхПриложений);
	Процесс.УстановитьПредставлениеСтрокиЗапуска(ПредставлениеКоманды);
	Процесс.ПоказыватьВыводНемедленно(Истина);

	КодВозврата = Процесс.Исполнить();
	ВыводКоманды = Процесс.ПолучитьВывод();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("ibcmd завершился с кодом %1 (%2)", КодВозврата, Режим);
	КонецЕсли;

	Возврат ВыводКоманды;

КонецФункции

// Создает описание аргумента командной строки ibcmd
//
// Параметры:
//  Имя - Строка - имя ключа (например, --db-path). Пусто - позиционный аргумент
//  Значение - Строка, Неопределено - значение ключа. Неопределено - ключ без значения
//  Секрет - Булево - значение не выводится в лог
//
// Возвращаемое значение:
//	Структура - аргумент:
//		* Текст - Строка - текст аргумента для командной строки
//		* Представление - Строка - текст аргумента для лога
//
Функция НовыйАргумент(Знач Имя, Знач Значение = Неопределено, Знач Секрет = Ложь)

	Если Значение = Неопределено Тогда
		Текст = Имя;
		Представление = Имя;
	Иначе
		ЭкранированноеЗначение = ЭкранироватьЗначение(Строка(Значение));
		ПредставлениеЗначения = ?(Секрет, "***", ЭкранированноеЗначение);
		Если ПустаяСтрока(Имя) Тогда
			Текст = ЭкранированноеЗначение;
			Представление = ПредставлениеЗначения;
		Иначе
			Текст = Имя + "=" + ЭкранированноеЗначение;
			Представление = Имя + "=" + ПредставлениеЗначения;
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("Текст, Представление", Текст, Представление);

КонецФункции

// Экранирует значение аргумента по правилам разбора командной строки (CommandLineToArgvW):
// значение с пробелами или кавычками обрамляется кавычками, кавычки и предшествующие им
// обратные слэши экранируются.
//
Функция ЭкранироватьЗначение(Знач Значение)

	Если Значение = "" Тогда
		Возврат """""";
	КонецЕсли;

	НужныКавычки = СтрНайти(Значение, " ") > 0
		ИЛИ СтрНайти(Значение, Символы.Таб) > 0
		ИЛИ СтрНайти(Значение, """") > 0;
	Если НЕ НужныКавычки Тогда
		Возврат Значение;
	КонецЕсли;

	Результат = "";
	КоличествоСлэшей = 0;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если Символ = "\" Тогда
			КоличествоСлэшей = КоличествоСлэшей + 1;
		ИначеЕсли Символ = """" Тогда
			Результат = Результат + Слэши(КоличествоСлэшей * 2 + 1) + """";
			КоличествоСлэшей = 0;
		Иначе
			Результат = Результат + Слэши(КоличествоСлэшей) + Символ;
			КоличествоСлэшей = 0;
		КонецЕсли;
	КонецЦикла;
	Результат = Результат + Слэши(КоличествоСлэшей * 2);

	Возврат """" + Результат + """";

КонецФункции

Функция Слэши(Знач Количество)

	Результат = "";
	Для Индекс = 1 По Количество Цикл
		Результат = Результат + "\";
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция АргументыРасширения(Знач ИмяРасширения)

	Аргументы = Новый Массив;
	Если ЗначениеЗаполнено(ИмяРасширения) Тогда
		Аргументы.Добавить(НовыйАргумент("--extension", ИмяРасширения));
	КонецЕсли;
	Возврат Аргументы;

КонецФункции

Функция ПредставлениеОбъекта(Знач ИмяРасширения)

	Если ЗначениеЗаполнено(ИмяРасширения) Тогда
		Возврат СтрШаблон("расширения %1", ИмяРасширения);
	КонецЕсли;
	Возврат "конфигурации";

КонецФункции

Процедура ДобавитьВМассив(Приемник, Знач Источник)

	Для Каждого Элемент Из Источник Цикл
		Приемник.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

Процедура ПриСозданииОбъекта()

	Лог = ПараметрыСистемы.Лог();
	АргументыПодключения = Новый Массив;
	АргументыАвторизации = Новый Массив;
	ВременныйКаталогДанных = Ложь;
	КаталогКонтроляОткрытыхПриложений = "";
	ВыводКоманды = "";

КонецПроцедуры

#КонецОбласти
